# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random string for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=inkingi-dev-secret-CHANGE-THIS-IN-PRODUCTION

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave blank (uses SQLite automatically)
# Render:    Render sets this for you automatically
# DATABASE_URL=postgresql://user:password@host:5432/inkingi_db

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
